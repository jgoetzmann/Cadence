# --- Bot runtime (pushed to the VM via push-env) ---
DISCORD_TOKEN=your-token-here
DISCORD_GUILD_ID=123456789012345678
LOG_LEVEL=INFO
CADENCE_DEFAULT_VOLUME=50

# VM-only yt-dlp tuning (set automatically by push-env on Oracle deploy)
YTDLP_PROXY=socks5h://127.0.0.1:1080
YTDLP_IMPERSONATE=chrome

# Optional: path to exported YouTube cookies (local file; push-cookies uploads to VM)
# YTDLP_COOKIE_FILE=/opt/cadence/youtube_cookies.txt

# --- Oracle deploy (toolkit only, NOT pushed) ---
# Use file paths under keys/ only. Never paste private key material into .env.
ORACLE_HOST=203.0.113.10
ORACLE_USER=ubuntu
ORACLE_SSH_KEY=C:\path\to\cadence\keys\oracle-vm-ssh-priv-key.key
ORACLE_SSH_PUB=C:\path\to\cadence\keys\oracle-vm-ssh-pub-key.pub
